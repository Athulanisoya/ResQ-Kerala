# scripts/setup.ps1 generates a private .env and .runtime/pgpass.conf automatically.
# These values document the isolated Week 1 defaults; do not copy the placeholder secret.
DATABASE_URL=postgresql+psycopg://resq_local@127.0.0.1:5443/resq_week1?passfile=ABSOLUTE_PATH_TO_PRIVATE_PGPASS_FILE
DATABASE_SCHEMA=resq_week1
JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRE_MINUTES=30
CORS_ORIGINS=http://127.0.0.1:8013,http://localhost:8013
APP_VERSION=1.0.0-week1

# Optional agent configuration. No OpenAI key is required: the Agents SDK
# calls Gemini Flash Live through Google's server-side WebSocket API.
# Secure local key setup: python -m scripts.configure_gemini
# Or supply GEMINI_API_KEY through your process environment / private .env.
GEMINI_MODEL=gemini-3.1-flash-live-preview
AGENT_TIMEOUT_SECONDS=45
AGENT_MAX_TURNS=6
# GEMINI_API_KEY_FILE=/absolute/path/to/private/gemini.key
