# scripts/setup.ps1 generates a private .env and .runtime/pgpass.conf automatically.
# These values document the isolated local defaults; do not copy the placeholder secret.
DATABASE_URL=postgresql+psycopg://resq_local@127.0.0.1:5443/resq_week1?passfile=ABSOLUTE_PATH_TO_PRIVATE_PGPASS_FILE
DATABASE_SCHEMA=resq_week1
JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRE_MINUTES=30
CORS_ORIGINS=http://127.0.0.1:8013,http://localhost:8013
APP_VERSION=2.0.0-integrated

# Optional agent configuration. The Agents SDK calls a local Gemma 4 model
# through Ollama. No provider API key is required.
# Verify/save local setup: python -m scripts.configure_ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b-it-q4_K_M
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_TURNS=6
# Shelter assistant defaults to local Ollama. To use Gemini explicitly, set
# WEEK4_LLM_PROVIDER=gemini and configure a private key file. Gemini receives the question.
# GEMINI_API_KEY_FILE=/absolute/path/to/private/gemini.key
